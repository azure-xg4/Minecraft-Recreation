
{
  "name": "blockworld",
  "version": "1.0.0",
  "description": "BlockWorld Minecraft Recreation",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.blockworld.game",
    "productName": "BlockWorld",
    "files": [
      "**/*",
      "!dist/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
